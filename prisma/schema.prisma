generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  TRADER
  VIEWER
}

enum AiProvider {
  CLAUDE
  OPENAI
}

enum TradeDirection {
  LONG
  SHORT
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum PlanStatus {
  PENDING
  TRIGGERED
  EXPIRED
  CANCELLED
}

enum AlertType {
  ENTRY_HIT
  EXIT_HIT
  STOP_HIT
  PRICE_ABOVE
  PRICE_BELOW
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  DISMISSED
}

enum SubscriptionPlan {
  FREE
  BASIC
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum DropdownCategory {
  STRATEGY_TAG
  INSTRUMENT
  PSYCHOLOGY_TAG
  TRADE_SETUP
  SESSION_TYPE
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role       @default(TRADER)
  aiProvider    AiProvider @default(CLAUDE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts         Account[]
  sessions         Session[]
  trades           Trade[]
  aiAnalyses       AiAnalysis[]
  groupMemberships GroupMember[]
  ownedGroups      TradingGroup[]
  tradePlans       TradePlan[]
  priceAlerts      PriceAlert[]
  subscription     Subscription?
  dropdownValues   UserDropdownValue[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model TradingGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User          @relation(fields: [ownerId], references: [id])
  members GroupMember[]
  trades  Trade[]

  @@map("trading_groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  userId   String
  groupId  String
  role     Role     @default(TRADER)
  joinedAt DateTime @default(now())

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  group TradingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@map("group_members")
}

model Trade {
  id            String         @id @default(cuid())
  userId        String
  groupId       String?
  instrument    String
  direction     TradeDirection
  entryPrice    Decimal        @db.Decimal(20, 8)
  exitPrice     Decimal?       @db.Decimal(20, 8)
  quantity      Decimal        @db.Decimal(20, 8)
  entryDate     DateTime
  exitDate      DateTime?
  strategyTag   String?
  sessionType   String?
  tradeSetup    String?
  notes         String?        @db.Text
  psychology    String?        @db.Text
  screenshotUrl String?
  pnl           Decimal?       @db.Decimal(20, 2)
  rMultiple     Decimal?       @db.Decimal(10, 4)
  stopLoss      Decimal?       @db.Decimal(20, 8)
  takeProfit    Decimal?       @db.Decimal(20, 8)
  commission    Decimal?       @db.Decimal(10, 4)
  status        TradeStatus    @default(OPEN)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group      TradingGroup? @relation(fields: [groupId], references: [id])
  aiAnalyses AiAnalysis[]
  linkedPlans TradePlan[]  @relation("LinkedTrade")

  @@index([userId, entryDate])
  @@index([userId, instrument])
  @@index([userId, strategyTag])
  @@map("trades")
}

model AiAnalysis {
  id        String     @id @default(cuid())
  tradeId   String?
  userId    String
  provider  AiProvider
  type      String
  content   String     @db.Text
  metadata  Json?
  createdAt DateTime   @default(now())

  trade Trade? @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tradeId])
  @@index([userId, type])
  @@map("ai_analyses")
}

model TradePlan {
  id            String         @id @default(cuid())
  userId        String
  date          DateTime
  instrument    String
  direction     TradeDirection
  entryPrice    Decimal        @db.Decimal(20, 8)
  stopLoss      Decimal        @db.Decimal(20, 8)
  takeProfit    Decimal        @db.Decimal(20, 8)
  rationale     String?        @db.Text
  status        PlanStatus     @default(PENDING)
  linkedTradeId String?
  alertsEnabled Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedTrade Trade?       @relation("LinkedTrade", fields: [linkedTradeId], references: [id])
  alerts      PriceAlert[]

  @@index([userId, date])
  @@map("trade_plans")
}

model PriceAlert {
  id          String      @id @default(cuid())
  userId      String
  planId      String?
  instrument  String
  alertType   AlertType
  targetPrice Decimal     @db.Decimal(20, 8)
  message     String?
  status      AlertStatus @default(ACTIVE)
  triggeredAt DateTime?
  createdAt   DateTime    @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan TradePlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("price_alerts")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  enabledBy            String?
  trialEndsAt          DateTime?
  expiresAt            DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("app_settings")
}

model UserDropdownValue {
  id        String           @id @default(cuid())
  userId    String
  category  DropdownCategory
  value     String
  label     String
  color     String?
  isDefault Boolean          @default(false)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, value])
  @@index([userId, category])
  @@map("user_dropdown_values")
}
