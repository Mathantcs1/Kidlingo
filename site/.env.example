# Copy to .env for local overrides. Never commit real values.
WP_PORT=8888
# Optional: path to a Chromium binary for Playwright (default: bundled/preinstalled)
PW_CHROMIUM_PATH=

# Stripe is TEST MODE ONLY. The keys are typed into WooCommerce > Settings > Payments > Stripe on the site, never into a
# file in this repo; these lines only document the shape. See docs/STRIPE_SETUP.md.
# STRIPE_TEST_PUBLISHABLE_KEY=pk_test_REPLACE_ME
# STRIPE_TEST_SECRET_KEY=sk_test_REPLACE_ME
# STRIPE_TEST_WEBHOOK_SECRET=whsec_REPLACE_ME
