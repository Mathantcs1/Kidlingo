#!/bin/sh
# Generated by new-film.sh: format __FORMAT__ (__W__x__H__ @ __FPS__). Usage: LIB=/path/to/lemo-opuscar sh build.sh [draft]
set -e
HERE=$(cd "$(dirname "$0")" && pwd)
LIB=${LIB:-${LEMO_OPUSCAR_HOME:-$HOME/lemo-opuscar}}; export LIB LEMO_ANGLE=${LEMO_ANGLE:-swiftshader}
. "$HERE/channel.env"
SIZE=__W__x__H__; [ "$1" = draft ] && SIZE=__DW__x__DH__
cd "$LIB"
node "$HERE/make-lines.mjs" "$HERE/script.md" "$HERE/lines.json"
.venv/bin/python core/tts/tts.py "$HERE/lines.json" "$HERE/voice" > /dev/null
.venv/bin/python core/tts/asr_check.py "$HERE/lines.json" "$HERE/voice" --lang en
node "$HERE/prepare.mjs" "$HERE" __FPS__
node "$HERE/stickset/estimate-cli.mjs" "$HERE" __FPS__ $SIZE __STYLE__ || { [ "$CONFIRM_LONG_RENDER" = 1 ] || { echo "stopping before the render: tell the user, then rerun with CONFIRM_LONG_RENDER=1 or make it shorter/draft"; exit 3; }; }
__RENDER__
.venv/bin/python "$HERE/mix.py" "$HERE" "$LIB"
sh core/render/mux.sh "$HERE/out/__VIDEO__" "$HERE/out/mix.wav" "$HERE/film-$SIZE.mp4" __FPS__
node "$HERE/srt-cues.mjs" "$HERE/timeline.json" "$HERE/out/cues.json" && .venv/bin/python core/render/srt.py "$HERE/out/cues.json" "$HERE/subtitles_en.srt"
